{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/experiment.schema.json",
  "title": "Memory poisoning experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "dataset", "memory", "attack", "evaluation", "models"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "subset", "seed", "events_path", "labels_path"],
      "properties": {
        "name": {"enum": ["personamem_v1", "personamem_v2", "mixed", "synthetic"]},
        "revision": {"type": "string", "minLength": 7},
        "subset": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "events_path": {"type": "string", "minLength": 1},
        "labels_path": {"type": "string", "minLength": 1}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "config_ref"],
      "properties": {
        "adapter": {"enum": ["telemem", "memanto", "langgraph"]},
        "config_ref": {"type": "string", "minLength": 1}
      }
    },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "variant", "budget", "target_policy"],
      "properties": {
        "family": {"enum": ["none", "direct_store", "query_only", "cross_user", "indirect_content"]},
        "variant": {"type": "string"},
        "budget": {"type": "integer", "minimum": 0},
        "target_policy": {"type": "string", "minLength": 1}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top_k", "repeats", "judge_config"],
      "properties": {
        "top_k": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "repeats": {"type": "integer", "minimum": 1},
        "judge_config": {"type": "string", "minLength": 1}
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assistant", "embedding"],
      "properties": {
        "assistant": {"type": "string", "minLength": 1},
        "embedding": {"type": "string", "minLength": 1}
      }
    }
  }
}
